# Server Configuration
PORT=4000
NODE_ENV=development
DEFAULT_CITY=nagpur

# Feature Flag: Enable non-v1 modules (payments, partner terminal, rewards, async queue)
# Defaults to false in production unless explicitly set to true
ENABLE_V2_MODULES=false

# Cloud Persistence (Firebase Firestore)
# When FIREBASE_PROJECT_ID is set, data persists to Cloud Firestore in addition to local cache.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Optional Local Disk DB Path (defaults to ./.data/rekart-db.json or /tmp/rekart-db.json on Vercel)
DATA_FILE_PATH=

# Optional Legacy PostgreSQL + PostGIS (only if USE_POSTGRES=true)
USE_POSTGRES=false
DATABASE_URL=postgresql://rekart_admin:rekart_secure_pass@localhost:5432/rekart_db

# Object Storage (Local / S3 compatible)
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=
S3_BUCKET=rekart-assets-nagpur
S3_ENDPOINT=http://localhost:9000

# AI Vision & Assistant (optional; OpenRouter is used first, then Gemini, otherwise manual confirmation)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=15000
DAILY_AI_QUOTA_PER_USER=25

# Approved pricing and quote data, supplied server-side only
ALLOW_RETAIL_PRICE_PUBLICATION=false
PHONE_PRICING_DATA_JSON=

# Security (required in production: the app refuses to start without JWT_SECRET)
JWT_SECRET=
PROOF_SIGNING_SECRET=
# Comma-separated origins allowed to call the API from another site. Leave empty for same-origin only.
CORS_ORIGINS=
# Password for the seeded demo accounts in production. Leave empty to create none.
SEED_DEMO_PASSWORD=
# Needed only if payment webhooks are enabled
RAZORPAY_KEY_SECRET=

# Server Configuration
PORT=4000
NODE_ENV=development
DEFAULT_CITY=nagpur

# Database (PostgreSQL + PostGIS)
# Set USE_POSTGRES=true when running with live PostgreSQL + PostGIS instance
USE_POSTGRES=false
DATABASE_URL=postgresql://rekart_admin:rekart_secure_pass@localhost:5432/rekart_db

# Object Storage (Local / S3 compatible)
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=rekart-assets-nagpur
S3_ENDPOINT=http://localhost:9000

# AI Vision (optional; OpenRouter is used first, then Gemini, then the local heuristic)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
GEMINI_API_KEY=

# Security (required in production: the app refuses to start without JWT_SECRET)
JWT_SECRET=
# Comma-separated origins allowed to call the API from another site. Leave empty for same-origin only.
CORS_ORIGINS=
# Password for the seeded demo accounts in production. Leave empty to create none.
SEED_DEMO_PASSWORD=
# Needed only if payment webhooks are enabled
RAZORPAY_KEY_SECRET=

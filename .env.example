# Server Configuration
PORT=4000
NODE_ENV=development
DEFAULT_CITY=nagpur

# Database (PostgreSQL + PostGIS)
# Set USE_POSTGRES=true when running with live PostgreSQL + PostGIS instance
USE_POSTGRES=false
DATABASE_URL=postgresql://rekart_admin:rekart_secure_pass@localhost:5432/rekart_db

# Object Storage (Local / S3 compatible)
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=rekart-assets-nagpur
S3_ENDPOINT=http://localhost:9000

# AI Vision (optional; OpenRouter is used first, then Gemini, then the local heuristic)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
GEMINI_API_KEY=

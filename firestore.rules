rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Owner-only user profile & point balances
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /point_balances/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Server-only via Admin SDK / service account
    }

    // Owner-only items, triage sessions, decisions, vouchers, point ledger
    match /items/{itemId} {
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    match /decisions/{decisionId} {
      allow read: if isOwner(resource.data.user_id) || isAdmin();
      allow write: if false; // Server-computed only
    }

    match /triage_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /point_ledger/{entryId} {
      allow read: if isOwner(resource.data.user_id) || isAdmin();
      allow write: if false;
    }

    match /vouchers/{voucherCode} {
      allow read: if isOwner(resource.data.user_id) || isAdmin();
      allow write: if false;
    }

    // Public read-only reference directory
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /price_benchmarks/{benchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /society_drives/{driveId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partner_demands/{demandId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
